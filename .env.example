# Copy to .env. Startup and scheduled sync read this file automatically.
# Empty values mean no external collection; credentials never appear in the UI.
PORT=8787
APIFY_TOKEN=
TIKTOK_DATASET_ID=
THREADS_DATASET_ID=
INSTAGRAM_DATASET_ID=
# Field mapping: upstream key -> internal key. Include record_type in each row.
TIKTOK_FIELD_MAP={}
THREADS_FIELD_MAP={}
INSTAGRAM_FIELD_MAP={}
# Legacy /api/collect compatibility only:
APIFY_DATASET_ID=
APIFY_FIELD_MAP={}
